; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppID={{0B8A2C89-7C37-4B42-AEE3-398C481872A5}}
AppName=ParetoAMBuild
AppVerName=ParetoAMBuild
AppPublisher=SciArt
DefaultDirName={pf64}\Pareto
DefaultGroupName=Pareto
AllowNoIcons=true
OutputBaseFileName=ParetoAMBuildInstaller
SetupIconFile=.\ParetoWinIcon.ico
Compression=lzma/Max
SolidCompression=true
LicenseFile=EULAAgreementParetoWin.txt
OutputDir=.

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 0,6.1

[Files]
Source: "..\..\build\ParetoAMBuild.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\build\charSet.bin"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\vc_redist.x64.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\imageformats\*"; DestDir: "{app}\imageformats\"; Flags: ignoreversion   recursesubdirs
Source: ".\platforms\*.dll"; DestDir: "{app}\platforms\"; Flags: ignoreversion   recursesubdirs
Source: "..\..\ParetoAMBuildExamples\*"; DestDir: "{userdesktop}\ParetoExamples\"; Flags: ignoreversion   recursesubdirs
Source: "..\..\resources\ParetoGuide.pdf"; DestDir: "{app}\"; Flags: ignoreversion   recursesubdirs
Source: "..\..\resources\ParetoMaterials.csv"; DestDir: "{app}\"; Flags: ignoreversion   recursesubdirs

[Icons]
Name: "{group}\ParetoAMBuild"; Filename: "{app}\ParetoAMBuild.exe"
Name: "{group}\{cm:UninstallProgram,Pareto}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\ParetoAMBuild"; Filename: "{app}\ParetoAMBuild.exe"; Tasks: desktopicon
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\ParetoAMBuild"; Filename: "{app}\ParetoAMBuild.exe"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\vc_redist.x64.exe";Parameters: "/passive /norestart"; Description: "VisualStudioRedistributable"; Flags: postinstall skipifsilent
Filename: "{app}\ParetoAMBuild.exe"; Description: ParetoAMBuild; Flags: nowait postinstall skipifsilent
